datasource postgresql {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

model User {
  id        Int       @id @default(autoincrement())
  name      String    @default("")
  email     String    @unique @default("")
  password  String
  roles     Json      @default("[]")
  createdAt DateTime? @default(now())
}

model Company {
  id          Int             @id @default(autoincrement())
  name        String          @default("")
  trade       String          @default("")
  street      String          @default("")
  houseNumber String          @default("")
  plz         String          @default("")
  city        String          @default("")
  contact     String          @default("")
  size        CompanySizeType
  verified    Boolean         @default(false)
  latitude    Float?
  longitude   Float?
  reviews     Review[]        @relation("Review_company")
}

model Review {
  id                               Int                                         @id @default(autoincrement())
  name                             String                                      @default("")
  email                            String                                      @default("")
  company                          Company?                                    @relation("Review_company", fields: [companyId], references: [id])
  companyId                        Int?                                        @map("company")
  collective                       Boolean                                     @default(false)
  hoursPerWeek                     Int?
  overtimePerMonth                 Int?
  trainingShortenable              Boolean                                     @default(false)
  partTime                         Boolean                                     @default(false)
  specialtiesOther                 String                                      @default("")
  ageAtEmployment                  Int?
  yearOfHiring                     String                                      @default("")
  yearOfLeaving                    String                                      @default("")
  ongoing                          Boolean                                     @default(false)
  genderIdentityRespected          Boolean                                     @default(false)
  position                         ReviewPositionType
  listenedTo                       ReviewListenedToType?
  canAskColleagues                 ReviewCanAskColleaguesType?
  canAskBoss                       ReviewCanAskBossType?
  tone                             ReviewToneType?
  explained                        ReviewExplainedType?
  proximity                        String?
  boundariesRespected              Json                                        @default("[]")
  appreciated                      ReviewAppreciatedType?
  experienceText                   String                                      @default("")
  languages                        String                                      @default("")
  gender                           ReviewGenderType?
  sharedWithCompany                ReviewSharedWithCompanyType?
  feltComfortableSharing           ReviewFeltComfortableSharingType?
  disabilityTypes                  Json                                        @default("[]")
  disabilitySharedWithCompany      ReviewDisabilitySharedWithCompanyType?
  disabilityFeltComfortableSharing ReviewDisabilityFeltComfortableSharingType?
  ethnicityTypes                   Json                                        @default("[]")
  ethnicitySharedWithCompany       ReviewEthnicitySharedWithCompanyType?
  ethnicityFeltComfortableSharing  ReviewEthnicityFeltComfortableSharingType?
  needsRespected                   ReviewNeedsRespectedType?
  feedback                         String                                      @default("")
  moreWishes                       String                                      @default("")
  status                           ReviewStatusType?                           @default(awaitingReview)
  emailVerified                    Boolean                                     @default(false)
  accessKey                        String                                      @unique @default("")

  @@index([companyId])
}

