model User {
  id        Int       @id @default(autoincrement())
  name      String    @default("")
  email     String    @unique @default("")
  password  String
  roles     Json
  createdAt DateTime? @default(now())
}

model Company {
  id        Int      @id @default(autoincrement())
  name      String   @default("")
