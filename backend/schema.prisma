  ongoing                          Boolean  @default(false)
  genderIdentityRespected          Boolean  @default(false)
  position                         String
  listenedTo                       String?
  canAskColleagues                 String?
  canAskBoss                       String?
  tone                             String?
  explained                        String?
  proximity                        String?
  boundariesRespected              Json
  appreciated                      String?
  experienceText                   String   @default("")
  languages                        String   @default("")
  gender                           String?
