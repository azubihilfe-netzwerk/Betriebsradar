// This file is automatically generated by Keystone, do not modify it manually.
// Modify your Keystone config when you want to change this.

datasource postgresql {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

model User {
  id        Int       @id @default(autoincrement())
  name      String    @default("")
  email     String    @unique @default("")
  password  String
  roles     Json      @default("[]")
  createdAt DateTime? @default(now())
}

model Company {
  id          Int             @id @default(autoincrement())
  name        String          @default("")
  trade       String          @default("")
  street      String          @default("")
  houseNumber String          @default("")
  plz         String          @default("")
  city        String          @default("")
  contact     String          @default("")
  size        CompanySizeType
  verified    Boolean         @default(false)
  latitude    Float?
  longitude   Float?
  reviews     Review[]        @relation("Review_company")
}

model Review {
  id                                  Int                                           @id @default(autoincrement())
  name                                String                                        @default("")
  email                               String                                        @default("")
  company                             Company?                                      @relation("Review_company", fields: [companyId], references: [id])
  companyId                           Int?                                          @map("company")
  collective                          Boolean                                       @default(false)
  hoursPerWeek                        Int?
  overtimePerMonth                    Int?
  trainingShortenable                 Boolean                                       @default(false)
  partTime                            Boolean                                       @default(false)
  specialtiesOther                    String                                        @default("")
  ageAtEmployment                     Int?
  yearOfHiring                        String                                        @default("")
  employmentDuration                  ReviewEmploymentDurationType
  overtimeHandling                    Json                                          @default("[]")
  overtimeHandlingOther               String                                        @default("")
  workplaceSafety                     ReviewWorkplaceSafetyType?
  position                            ReviewPositionType
  listenedTo                          ReviewListenedToType?
  canAskColleagues                    ReviewCanAskColleaguesType?
  canAskBoss                          ReviewCanAskBossType?
  canAskTrainer                       ReviewCanAskTrainerType?
  tone                                ReviewToneType?
  explained                           ReviewExplainedType?
  boundariesRespected                 Json                                          @default("[]")
  appreciated                         ReviewAppreciatedType?
  experienceText                      String                                        @default("")
  languages                           String                                        @default("")
  genderDiscriminationExperienced     ReviewGenderDiscriminationExperiencedType     @default(no)
  genderDiscriminationObserved        ReviewGenderDiscriminationObservedType        @default(no)
  ethnicityDiscriminationExperienced  ReviewEthnicityDiscriminationExperiencedType  @default(no)
  ethnicityDiscriminationObserved     ReviewEthnicityDiscriminationObservedType     @default(no)
  disabilityDiscriminationExperienced ReviewDisabilityDiscriminationExperiencedType @default(no)
  disabilityDiscriminationObserved    ReviewDisabilityDiscriminationObservedType    @default(no)
  discriminationExperienceText        String                                        @default("")
  feedback                            String                                        @default("")
  moreWishes                          String                                        @default("")
  recommend                           ReviewRecommendType?
  status                              ReviewStatusType?                             @default(awaitingReview)
  emailVerified                       Boolean                                       @default(false)
  accessKey                           String                                        @unique @default("")

  @@index([companyId])
}

enum CompanySizeType {
